{
  "extends": "config/typescript/base.json",
  "include": ["**/*.ts", "**/*.tsx", "env.d.ts"],
  // server-prod.ts 与 .assets.generated.ts 是二进制入口/构建产物（Bun 专属 API、
  // 内嵌资源导入），不参与应用类型检查；scripts/build-binary.ts 同理。
  "exclude": [
    "node_modules",
    "coverage",
    ".storybook",
    "dist",
    ".output",
    ".nitro",
    ".tanstack",
    "server-prod.ts",
    ".assets.generated.ts",
    "scripts/build-binary.ts",
  ],
  "compilerOptions": {
    "target": "ES2022",
    "jsx": "react-jsx",
    "module": "ESNext",
    "paths": {
      "@web": ["./src/"],
      "@web/*": ["./src/*"],
      "@api": ["../api/src/index.ts"],
      "@api/*": ["../api/src/*"],
      "@libs": ["../../packages/libs/src/index.ts"],
      "@libs/*": ["../../packages/libs/src/*"]
    },
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["vite/client"],
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "declaration": false,
    "declarationMap": false,
    /* Linting */
    "skipLibCheck": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true
  }
}
