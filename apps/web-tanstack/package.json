{
  "name": "web-tanstack",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bunx --bun vite dev --port 3000",
    "build": "bunx --bun vite build",
    "build:binary": "bun run scripts/build-binary.ts",
    "start": "bun .output/server/index.mjs",
    "preview": "bun --bun vite preview",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "test": "vitest run",
    "check:contrast": "bun scripts/check-contrast.ts",
    "format": "biome format --write",
    "check": "biome check",
    "docker": "cd ../.. && docker build -t mono-web:$(node -e \"console.log(require('./apps/api/package.json').version)\") -f ./apps/web-tanstack/Dockerfile .",
