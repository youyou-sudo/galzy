{
  "name": "web-tanstack",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --hot src/server.ts",
    "build": "furin build --target bun",
    "build:binary": "furin build --target bun --compile embed",
    "start": "bun .furin/build/bun/server.js",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "test": "vitest run",
    "check:contrast": "bun scripts/check-contrast.ts",
    "format": "biome format --write",
    "docker": "cd ../.. && docker build -t mono-web:$(node -e \"console.log(require('./apps/api/package.json').version)\") -f ./apps/web-tanstack/Dockerfile .",
    "docker:web-tanstack": "cd ../.. && docker build -t mono-web:$(node -e \"console.log(require('./apps/api/package.json').version)\") -f ./apps/web-tanstack/Dockerfile .",
    "start:binary": "./.furin/build/bun/server",
    "typegen": "furin typegen"
  },
  "dependencies": {
