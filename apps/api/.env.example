NODE_ENV=development
API_PORT=3001
API_HOST=http://localhost
# WEB_HOST=https://galzy.moe
WEB_HOST=http://localhost:3000

# Auth
BETTER_AUTH_SECRET=your-better-auth-secret
BETTER_AUTH_URL=http://localhost:3001

# Database
#
VNDB_API_TOKEN="your-vndb-api-token"
VNDB_DATABASE_URL="postgresql://user:password@host:5432/dbname"
DATABASE_URL="postgresql://user:password@host:5432/dbname"
POSTGRES_POOL_MAX=10


# Meilisearch
MEILISEARCH_HOST=http://your-meilisearch-host:80
MEILISEARCH_MASTER=your-meilisearch-master-key
MEILISEARCH_INDEXNAME=galzy_games
MEILISEARCH_TAG_INDEXNAME=galrc_Tag
MEILISEARCH_PRODUCER_INDEXNAME=galrc_Producer

# Redis
REDIS_URL=
# 开发模式（NODE_ENV != production）下 Redis 默认不生效：缓存直查 DB、锁/幂等直接放行。
# 如需在本地调试缓存，可设 REDIS_ENABLED=true 强制开启
# REDIS_ENABLED=true

# 任务队列（@stacksjs/bun-queue，复用 Bun 内置 redis）
# 队列日志/记录 TTL（PostgreSQL 侧，单位天）：log 默认 14、job 记录默认 90
# QUEUE_LOG_TTL_DAYS=14
# QUEUE_JOB_RETENTION_DAYS=90

# S3_BUCKET=dokployBacker
# S3_ACCESS_KEY_ID=0051433242f2f5f0000000006
# S3_SECRET_ACCESS_KEY=K005FdwmOTEGqDehVQzgqqvHkqLJ6Gg
# S3_ENDPOINT=https://s3.us-east-005.backblazeb2.com
# S3_REGION=us-east-005


S3_BUCKET=your-s3-bucket
S3_ACCESS_KEY_ID=your-s3-access-key
S3_SECRET_ACCESS_KEY=your-s3-secret-key
S3_ENDPOINT=https://your-s3-endpoint
S3_REGION=your-s3-region
S3_IMAGEURL=https://your-s3-image-url

# S3_BUCKET=rustfs
# S3_ACCESS_KEY_ID=rustfsadmin
# S3_SECRET_ACCESS_KEY=duqecwr1ng8odh2t
# S3_ENDPOINT=http://personalservice-rustfs-8d07b0-107-175-155-157.sslip.io
# S3_REGION=openlist
# S3_IMAGEURL=https://c.galzy.eu.org/p/test
# Game cover image CDN base URL (replaces t.vndb.org)
# GAME_IMAGE_BASE_URL=https://img.example.com


# Cloudreve（游戏文件存储，替换原 Openlist/Alist API）
CLOUDREVE_HOST=https://cloudreve.con
CLOUDREVE_EMAIL=your-cloudreve-email
CLOUDREVE_PASSWORD=your-cloudreve-password
# 媒体文件（图片）在 Cloudreve 中的存放目录，默认 /upload
# CLOUDREVE_UPLOAD_DIR=/upload

# EMAIL_KEY
EMAIL_KEY=your-email-key

# Oauth
LINUXDO_CLIENT_ID=your-linuxdo-client-id
LINUXDO_CLIENT_SECRET=your-linuxdo-client-secret

GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret

DISCORD_CLIENT_ID=your-discord-client-id
DISCORD_CLIENT_SECRET=your-discord-client-secret

KUNGAL_CLIENT_ID=your-kungal-client-id
KUNGAL_CLIENT_SECRET=your-kungal-client-secret

TWITTER_CLIENT_ID=your-twitter-client-id
TWITTER_CLIENT_SECRET=your-twitter-client-secret

# Cloudflare Cache Purge (ISR: clear CDN cache when data changes)
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_API_TOKEN=
SITE_URL=https://example.com
