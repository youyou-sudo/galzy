{
  "name": "api",
  "version": "0.0.1",
  "private": true,
  "license": "MIT",
  "scripts": {
    "dev": "bun run --watch src/index.ts",
    "build": "bun build --compile --minify-whitespace --minify-syntax --target bun --outfile server ./src/index.ts",
    "lint": "biome check --write",
    "format": "biome format --write .",
    "check": "biome check",
    "docker": "cd ../.. && docker build -t mono-api:$(node -e \"console.log(require('./apps/api/package.json').version)\") -f ./apps/api/Dockerfile .",
    "docker:api": "cd ../.. && docker build -t mono-api:$(node -e \"console.log(require('./apps/api/package.json').version)\") -f ./apps/api/Dockerfile .",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:check": "drizzle-kit check",
    "db:up": "drizzle-kit up"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "^1.6.26",
    "@elysia/openapi": "^1.4.15",
    "@elysiajs/cors": "^1.4.2",
    "@elysiajs/opentelemetry": "1.4.11",
    "@sinclair/typebox": "^0.34.52",
    "@stacksjs/bun-queue": "0.1.8",
    "@types/node": "^26.2.0",
    "@types/xxhashjs": "^0.2.4",
    "ajv": "^8.20.0",
    "better-auth-localization": "^3.0.0",
    "drizzle-orm": "^0.45.2",
    "elysia": "^1.4.29",
    "meilisearch": "^0.58.0",
    "unemail": "^0.4.1",
    "xxhashjs": "^0.2.2"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "config": "workspace:*",
    "drizzle-kit": "^0.31.10"
  }
}
