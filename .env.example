# ============================================================
# Galzy Docker Compose 部署环境变量模板
# 用法：cp .env.example .env，然后逐项填写
# docker-compose.yml 会自动读取同目录的 .env
# ============================================================

# ================= compose 插值变量（必填） =================
# docker-compose.yml 直接通过 ${...} 引用这些值，缺失会启动失败。
# 注意：POSTGRES_* 同时用于构建 api 容器内部直连的 DATABASE_URL，
# 而 MEILI_MASTER_KEY 必须与下方 MEILISEARCH_MASTER 保持一致。
POSTGRES_USER=galzy
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=galzy
MEILI_MASTER_KEY=change-me-long-random-master-key

# ================= 服务间内部地址 =================
# Web(BFF) 容器通过 API_HOST 访问 API 容器。
# 必须用 compose 服务名 http://api:3001，不能用 localhost（容器内会连自己）。
API_HOST=http://api:3001

# DATABASE_URL / REDIS_URL / MEILISEARCH_HOST 无需在此填写——
# docker-compose.yml 的 environment 已为 api 容器覆盖为内部服务地址
# （postgres:5432 / redis:6379 / meilisearch:7700）。

# ================= 站点基础配置 =================
# 生产模式（Dockerfile 已内置，此处显式声明便于理解）
NODE_ENV=production

# 公网站点地址（无尾部斜杠）。
# 用于：OAuth 回调地址（WEB_HOST + /api/auth/callback/...）、评论邮件链接、CORS 白名单。
WEB_HOST=https://galzy.moe

# Better Auth 会话签名密钥（必填，务必随机生成，如 openssl rand -base64 32）
BETTER_AUTH_SECRET=change-me-better-auth-secret

# ================= Meilisearch =================
# API 客户端使用的 key —— 必须与上方 MEILI_MASTER_KEY 完全一致
MEILISEARCH_MASTER=change-me-long-random-master-key
# 索引名（可选，有默认值）
MEILISEARCH_INDEXNAME=galzy_games
MEILISEARCH_TAG_INDEXNAME=galrc_Tag
MEILISEARCH_PRODUCER_INDEXNAME=galrc_Producer

# ================= PostgreSQL =================
# 连接池上限（可选，默认 5）
# POSTGRES_POOL_MAX=10

# ================= VNDB 数据同步 =================
# VNDB API Token（vndb-sync 同步游戏数据用，必填才能同步）
VNDB_API_TOKEN=your-vndb-api-token

# ================= Redis =================
# 生产模式（NODE_ENV=production）下 Redis 默认生效。
# 若无需缓存/锁/幂等，可设 REDIS_ENABLED=false 强制关闭。
# REDIS_ENABLED=true

# ================= 对象存储（S3，媒体上传） =================
# 头像、游戏媒体图上传与 CDN 直链
S3_BUCKET=your-s3-bucket
S3_ACCESS_KEY_ID=your-s3-access-key
S3_SECRET_ACCESS_KEY=your-s3-secret-key
S3_ENDPOINT=https://your-s3-endpoint
S3_REGION=your-s3-region
S3_IMAGEURL=https://your-s3-image-url
# 游戏封面图 CDN 基础地址（可选，默认 t.vndb.org）
# GAME_IMAGE_BASE_URL=https://img.example.com

# ================= Cloudreve（游戏文件存储） =================
# 替换原 Alist 的下载文件存储
CLOUDREVE_HOST=https://cloudreve.example.com
CLOUDREVE_EMAIL=your-cloudreve-email
CLOUDREVE_PASSWORD=your-cloudreve-password
# 媒体文件在 Cloudreve 中的存放目录（可选，默认 /upload）
# CLOUDREVE_UPLOAD_DIR=/upload

# ================= 邮件通知（评论回复等） =================
# Resend API Key
EMAIL_KEY=your-resend-api-key

# ================= OAuth 登录（按需填写） =================
# 只填你要启用的 provider，未配置的自动不启用
LINUXDO_CLIENT_ID=your-linuxdo-client-id
LINUXDO_CLIENT_SECRET=your-linuxdo-client-secret

GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret

DISCORD_CLIENT_ID=your-discord-client-id
DISCORD_CLIENT_SECRET=your-discord-client-secret

KUNGAL_CLIENT_ID=your-kungal-client-id
KUNGAL_CLIENT_SECRET=your-kungal-client-secret

TWITTER_CLIENT_ID=your-twitter-client-id
TWITTER_CLIENT_SECRET=your-twitter-client-secret

# ================= Cloudflare（可选，ISR 缓存清理） =================
# 数据变更时清除 CDN 缓存，不配置则跳过
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_API_TOKEN=

# ================= 站点统计（可选） =================
# UMAMI_SCRIPT_URL=https://analytics.example.com/script.js
# UMAMI_DATA_WEBSITE_ID=your-umami-site-id

# ================= 其他可选 =================
# BFF → API 请求超时（毫秒，默认 30000）
# FETCH_TIMEOUT_MS=30000
